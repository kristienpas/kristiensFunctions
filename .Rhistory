# Start with 1000€ budget
wallet = 1000
# Simulate 1000 rounds
for (game in 1:1000) {
throw = sample(1:6, 4, replace = TRUE)
winning_die = sum(throw < 3)
if (winning_die >= 3){
wallet = wallet + 4
} else {
wallet = wallet - 1
}
}
